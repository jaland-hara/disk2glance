# /etc/disk2glance/openrc — mode 600, root only. Never commit real values.
export OS_AUTH_URL="https://infra.mail.ru:35357/v3/"
export OS_PROJECT_ID="<project id>"
export OS_REGION_NAME="RegionOne"
export OS_USERNAME="<service user>"
export OS_USER_DOMAIN_NAME="<user domain>"
export OS_PASSWORD="<password>"
# or, instead of user/password (if the cloud supports application credentials):
# export OS_APPLICATION_CREDENTIAL_ID="<id>"
# export OS_APPLICATION_CREDENTIAL_SECRET="<secret>"
