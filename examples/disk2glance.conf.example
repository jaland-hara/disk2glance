# /etc/disk2glance/disk2glance.conf — параметры disk2glance по умолчанию.
# Читаются только строки вида КЛЮЧ=значение (файл не выполняется).
# Параметры командной строки важнее этого файла.

# Файл с учётными данными целевого облака
OPENRC=/etc/disk2glance/openrc

# Свойства создаваемого образа (JSON)
PROPS=/etc/disk2glance/props.json

# Какой диск переносить
DISK=/dev/vda

# Размер COW-файла на каждый снапшот, МиБ (пусто = 10% тома)
COW_MB=
